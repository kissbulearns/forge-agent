# Forge Agent connection values.
# Copy to ~/.forge-agent/.env (recommended: outside every repository)
# or to .env in a workspace root that lists .env in .gitignore.

TENANT_ID = ""
CLIENT_ID = ""
CLIENT_SECRET = ""
SCOPE = ""
AZURE_OPENAI_ENDPOINT = ""
OPENAI_API_VERSION = ""
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME = ""
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_NAME = ""

# Optional: use an API key instead of the service principal above.
# AZURE_OPENAI_API_KEY = ""
